# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=visiontech

# Application
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:4200

# Email Configuration (Optional - for contact form notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
# Gmail only accepts a From that is the authenticated account or a verified
# "Send mail as" alias — anything else is rejected or silently rewritten.
SMTP_FROM=your-email@gmail.com
# Must be a mailbox that actually receives mail. visiontech.al has no MX
# records, so contact@visiontech.al bounces until email routing is set up.
CONTACT_EMAIL=your-email@gmail.com

# JWT (for future admin panel)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

